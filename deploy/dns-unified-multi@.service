[Unit]
Description=DNS Unified Multi backend (%i)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=30
StartLimitBurst=3
[Service]
Type=simple
User=root
WorkingDirectory=/opt/dns-unified-control
ExecStart=/opt/dns-unified-control/.venv/bin/python -m ducmulti.engine %i
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
[Install]
WantedBy=multi-user.target
