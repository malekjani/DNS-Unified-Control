[Unit]
Description=DNS Unified Multi DNS Router (authoritative 53)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=30
StartLimitBurst=3
[Service]
Type=simple
User=root
WorkingDirectory=/opt/dns-unified-control
ExecStart=/opt/dns-unified-control/.venv/bin/python -m ducmulti.router --config /etc/dns-unified/multi-router.json
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadOnlyPaths=/etc/dns-unified
[Install]
WantedBy=multi-user.target
